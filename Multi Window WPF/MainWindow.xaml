<Window x:Class="Multi_Window_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Multi_Window_WPF"
        mc:Ignorable="d"
        Title="Assignment 3 - Display Window" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Name:" FontSize="16" HorizontalAlignment="Center"/>
            <Label Content="" FontSize="16" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Age:" FontSize="16" HorizontalAlignment="Center"/>
            <Label Content="" FontSize="16" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <CheckBox Content="Adult" FontSize="16" />
        </StackPanel>
        <Button Width="150" Height="50" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10" FontWeight="Bold" FontSize="20" IsDefault="True" Click="Button_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/Image/edit-icon.png" Width="30" Height="30"/>
                <AccessText Text="_Edit" FontSize="18" FontWeight="Bold"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
